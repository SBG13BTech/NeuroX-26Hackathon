# ==============================================================================
# Funobotz Learning Assistance System - Environment Variables
# ==============================================================================

# 1. Google Gemini API Key
# Add your Google Gemini API key below:
GEMINI_API_KEY=your_gemini_api_key_here

# 2. MySQL Database Configuration (PyMySQL)
# Update these with your local MySQL credentials:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=funobotz_db
PORT=8001
